generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    password  String
    createdAt DateTime @default(now())

    revenues   Revenue[]
    expenses   Expense[]
    categories ExpenseCategory[]
}

model Revenue {
    id        String   @id @default(uuid())
    month     Int
    year      Int
    createdAt DateTime @default(now())

    userId Int
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    categories RevenueCategory[]
}

model RevenueCategory {
    id        String   @id @default(uuid())
    name      String
    amount    Float
    createdAt DateTime @default(now())

    revenueId String
    revenue   Revenue @relation(fields: [revenueId], references: [id], onDelete: Cascade)
}

model Expense {
    id     String   @id @default(uuid())
    name   String
    amount Float
    date   DateTime

    userId Int
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    categoryId String
    category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
}

model ExpenseCategory {
    id          String   @id @default(uuid())
    name        String
    percentage  Float
    shouldSpend Float
    goal        String
    createdAt   DateTime @default(now())

    userId Int
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    expenses Expense[]
}
