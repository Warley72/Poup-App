generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    password  String   @unique
    createdAt DateTime @default(now())

    revenues Revenues[]
    expenses Expense[]
}

model Revenues {
    id        String   @id @default(uuid())
    total     Float
    month     Int
    year      Int
    createdAt DateTime @default(now())

    userId Int
    user   User @relation(fields: [userId], references: [id])

    categories RevenueCategory[]
}

model RevenueCategory {
    id        String   @id @default(uuid())
    name      String
    amount    Float
    createdAt DateTime @default(now())

    revenuesId String
    revenues   Revenues @relation(fields: [revenuesId], references: [id])
}

model Expense {
    id        String   @id @default(uuid())
    name      String
    amount    Float
    createdAt DateTime @default(now())

    userId Int
    user   User @relation(fields: [userId], references: [id])

    categoryId String
    category   ExpenseCategory @relation(fields: [categoryId], references: [id])
}

model ExpenseCategory {
    id          String   @id @default(uuid())
    name        String
    percentage  Float
    shouldSpend Float
    amountSpent Float    @default(0)
    utilized    Float    @default(0)
    goal        String?
    createdAt   DateTime @default(now())

    expenses Expense[]
}
